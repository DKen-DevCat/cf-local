{
  "policies": {
    "default": {
      "headers":       { "whitelist": [] },
      "cookies":       { "whitelist": [] },
      "query_strings": { "whitelist": [] },
      "accept_encoding_normalize": true,
      "min_ttl":     0,
      "max_ttl":     31536000,
      "default_ttl": 86400
    },
    "with-session": {
      "headers":       { "whitelist": [] },
      "cookies":       { "whitelist": ["session_id"] },
      "query_strings": { "whitelist": [] },
      "accept_encoding_normalize": true,
      "min_ttl":     0,
      "max_ttl":     31536000,
      "default_ttl": 86400
    },
    "with-locale": {
      "headers":       { "whitelist": ["Accept-Language"] },
      "cookies":       { "whitelist": [] },
      "query_strings": { "whitelist": ["lang"] },
      "accept_encoding_normalize": true,
      "min_ttl":     0,
      "max_ttl":     31536000,
      "default_ttl": 86400
    },
    "_test-empty-cookie": {
      "_comment": "Phase 1 test-only — exists solely to exercise parseCookieHeader's handling of empty cookie names. No location maps to this policy.",
      "headers":       { "whitelist": [] },
      "cookies":       { "whitelist": [""] },
      "query_strings": { "whitelist": [] },
      "accept_encoding_normalize": false,
      "min_ttl":     0,
      "max_ttl":     31536000,
      "default_ttl": 86400
    },
    "_test-ttl-clamp": {
      "_comment": "Phase 2 test-only — non-default min/max/default to exercise ttl.compute clamp logic. No location maps to this policy.",
      "headers":       { "whitelist": [] },
      "cookies":       { "whitelist": [] },
      "query_strings": { "whitelist": [] },
      "accept_encoding_normalize": true,
      "min_ttl":     60,
      "max_ttl":     120,
      "default_ttl": 300
    }
  }
}
