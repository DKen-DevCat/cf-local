vendor/

# Build artifacts
# Phase 3 A.4.12: ./cf-local/ ディレクトリは user 設定置き場 (cache-policies/ +
# distributions/) として tracked。Go binary を ad-hoc に build する場合は
# `go build -o /tmp/cf-local ./cmd/cf-local` のように repo 外に出す運用。
# 通常の build は docker (`docker compose up --build`) 経由なので host に
# binary は残らない。
/dist/
/bin/

# BoltDB data
*.db
/data/

# nginx
/nginx-cache/
*.log

# golden file テスト不一致時に書き出される actual output (assertGolden が生成)
internal/**/testdata/**/*.got

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local

# Docker
docker-compose.override.yml

# Claude Code skill ランタイム生成物 (clone 毎に再生成される)
.claude/scheduled_tasks.lock

# /goal:exec が codex の各タスク出力を書き出す作業用ディレクトリ
.codex-out/

# Terraform runtime artifacts (examples の walkthrough で生成される)。
# .terraform.lock.hcl は provider 固定用に各 example で必要なら個別に commit する。
**/.terraform/
**/*.tfstate
**/*.tfstate.*
